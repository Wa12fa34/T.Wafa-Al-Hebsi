# English Learning Hub — public frontend environment variables
# Copy this file to .env.local and insert your Supabase project values.
# Never place a service-role key or password in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
